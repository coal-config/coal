{
  "name": "coal",
  "displayName": "coal",
  "description": "Language Server for COAL",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:coal"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "coal",
        "aliases": ["COAL", "coal"],
        "extensions": [".coal"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "COAL",
      "properties": {
        "coal.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the coal-lsp executable. If left empty, the extension will look for 'coal-lsp' in your system PATH."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}